# Example environment variables. Copy to .env and fill in your own values.
# Never commit real secrets to this file.

# Existing (keep your current values)
# MONGODB_URI=
# JWT_SECRET=
# NEXT_PUBLIC_APP_URL=

# Daily scheduled email (Resend + cron-job.org)
CRON_SECRET=your-secure-random-cron-secret
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev
DAILY_EMAIL_TO=you@example.com
